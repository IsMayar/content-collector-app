{
  "title": "Website Content Collector MVP API inventory",
  "version": "1.0",
  "notice": "Endpoint design inventory, not an executable OpenAPI schema. Use guide authorization and lifecycle rules in every controller.",
  "basePath": "/api/v1",
  "defaultPrivateHeaders": {
    "Cache-Control": "no-store"
  },
  "mutations": {
    "csrf": "X-XSRF-TOKEN for cookie-based authentication",
    "idempotency": "Idempotency-Key where required",
    "concurrency": "Explicit expectedVersion in body"
  },
  "sharedPayloads": {
    "Page": {
      "page": "integer>=0",
      "size": "1..100",
      "totalElements": "integer>=0"
    },
    "Project": {
      "id": "uuid",
      "workspaceId": "uuid",
      "projectType": [
        "WEBSITE",
        "WEB_APP",
        "MOBILE_APP"
      ],
      "state": [
        "DRAFT",
        "ACTIVE",
        "PAUSED",
        "COMPLETED",
        "ARCHIVED",
        "DELETION_PENDING"
      ],
      "version": "integer",
      "structureVersion": "integer"
    },
    "Answer": {
      "itemId": "uuid",
      "value": "typed JSON by field",
      "version": "integer",
      "savedAt": "instant"
    },
    "Progress": {
      "requiredTotal": "integer",
      "submittedRequired": "integer",
      "approvedRequired": "integer",
      "clientActionRequired": "integer",
      "optionalApproved": "integer"
    },
    "ReminderRule": {
      "id": "uuid",
      "channel": [
        "EMAIL",
        "SMS"
      ],
      "daysRelativeToDueDate": "integer -30..90",
      "localTime": "HH:mm",
      "weekdaysOnly": "boolean"
    },
    "ClientInteractionEvent": {
      "clientEventId": "uuid",
      "type": [
        "project_opened",
        "item_started"
      ],
      "itemId": "uuid optional",
      "occurredAt": "untrusted client instant optional"
    },
    "Problem": {
      "type": "URI",
      "title": "string",
      "status": "HTTP integer",
      "code": "stable string",
      "detail": "safe string",
      "traceId": "string",
      "errors": "fieldPath and message[]"
    }
  },
