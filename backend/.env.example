
# AYAANTRIX Content Collector — Backend Configuration
# Save as backend/.env (ignored by Git).
# Environment variables override values in this file.

# ============================================
# DATABASE
# ============================================
DATABASE_URL=jdbc:postgresql://127.0.0.1:5433/collector_dev
DATABASE_USERNAME=collector_dev
DATABASE_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
SERVER_PORT=8080

# ============================================
# AUTHENTICATION AND SECURITY
# ============================================
# Base64 of 32 random bytes.
TOKEN_DELIVERY_ENCRYPTION_KEY=
TOKEN_DELIVERY_ENCRYPTION_KEY_ID=local-v1

# Local frontend. HTTPS will be configured
# before enabling Stripe hosted Checkout.
APP_BASE_URL=http://127.0.0.1:5173

REGISTRATION_PER_MINUTE=5
VERIFICATION_PER_MINUTE=20
RECOVERY_PER_MINUTE=5
RESET_PER_MINUTE=20
RECOVERY_MIN_RESPONSE_MS=250

# ============================================
# ACCOUNT DELIVERY
# ============================================
ACCOUNT_DELIVERY_WORKER_ENABLED=false
ACCOUNT_DELIVERY_DEV_INBOX=false
ACCOUNT_DELIVERY_BATCH_SIZE=10
ACCOUNT_DELIVERY_POLL_MS=1000
ACCOUNT_DELIVERY_SHUTDOWN_SECONDS=10

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEYS=
JWT_KEY_ID=
JWT_ISSUER=
JWT_AUDIENCE=
TOKEN_HASH_PEPPER=
LOGIN_PER_MINUTE=10

# ============================================
# LEGACY TRIAL CONFIGURATION
# New workspaces use permanent FREE.
# ============================================
TRIAL_AI_DRAFTS=0
TRIAL_SMS_SEGMENTS=0

# ============================================
# PRIVATE STORAGE
# ============================================
PRIVATE_STORAGE_ENABLED=false
PRIVATE_STORAGE_WORKER_ENABLED=false

S3_ENDPOINT=http://127.0.0.1:8333
S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET_STAGING=collector-staging
S3_BUCKET_PRIVATE=collector-private
S3_ACCESS_KEY=
S3_SECRET_KEY=

CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=13310
IMAGE_WORKER_IMAGE=collector-image-worker:t19
IMAGE_WORKER_DOCKER=docker

# ============================================
# EXPORT WORKER
# ============================================
EXPORT_WORKER_ENABLED=false

# ============================================
# AI CONFIGURATION
# ============================================
AI_ENABLED=false
AI_WORKER_ENABLED=false

OPENAI_API_KEY=
AI_MODEL=

AI_INPUT_MICROUSD_PER_TOKEN=0
AI_OUTPUT_MICROUSD_PER_TOKEN=0
AI_MONTHLY_BUDGET_MICROUSD=0
AI_MAX_OUTPUT_TOKENS=2048

# ============================================
# EMAIL REMINDERS
# ============================================
REMINDER_WORKER_ENABLED=false
REMINDER_EMAIL_ENABLED=false

EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_WEBHOOK_SECRET=
EMAIL_WEBHOOK_URL=

# ============================================
# SMS / TWILIO
# ============================================
SMS_ENABLED=false
SMS_ONBOARDING_APPROVED=false
SMS_WORKER_ENABLED=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_INBOUND_URL=
TWILIO_STATUS_URL=

SMS_SEGMENT_COST_MICROUSD=0
SMS_MONTHLY_BUDGET_MICROUSD=0

# ============================================
# PROVIDER RECONCILIATION
# ============================================
PROVIDER_RECONCILIATION_ENABLED=false

# ============================================
# DIGEST WORKER
# ============================================
DIGEST_WORKER_ENABLED=false

# ============================================
# STRIPE SANDBOX — TEST MODE ONLY
# ============================================

# Enable only after Stripe test setup is complete.
BILLING_ENABLED=false
BILLING_WORKER_ENABLED=false

# Stripe test API secret key
# Configure locally in the next step.
STRIPE_SECRET_KEY=sk_test_REDACTED

# Stripe CLI webhook signing secret
# Configure locally after starting webhook forwarding.
STRIPE_WEBHOOK_SECRET=

# SOLO — $7 USD per month
STRIPE_SOLO_PRICE_ID=price_1UeFU68afTGwDbZqJhpPaVc5

# AGENCY — $19 USD per month
STRIPE_AGENCY_PRICE_ID=price_1UeFd18afTGwDbZqr7Z5xKvf

# Optional historical price IDs.
# Leave blank if no legacy Stripe subscriptions exist.
STRIPE_LEGACY_SOLO_PRICE_ID=
STRIPE_LEGACY_AGENCY_PRICE_ID=

# Stripe customer portal configuration
# Configure in the next setup steps.
STRIPE_PORTAL_CONFIGURATION_ID=

# IMPORTANT:
# Before enabling billing, APP_BASE_URL must be
# an approved HTTPS frontend origin.
#
# Stripe customer portal must disable direct
# subscription updates and allow cancellation
# only at the end of the billing period.
#
# FREE plan ($0 forever) is managed in the app.
# Production activation is explicit; defaults remain sandbox and disabled.
BILLING_MODE=SANDBOX
BILLING_LIVE_ACTIVATION=false
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
# No Stripe product or payment method is required.
