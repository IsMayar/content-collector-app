# Copy to backend/.env (ignored by Git) and replace the password locally.
# Simple KEY=value properties without quotes. Environment variables override this file.
DATABASE_URL=jdbc:postgresql://127.0.0.1:5433/collector_dev
DATABASE_USERNAME=collector_dev
DATABASE_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
SERVER_PORT=8080

# Required for registration token issuance; Base64 of 32 random bytes. No default secret.
TOKEN_DELIVERY_ENCRYPTION_KEY=
TOKEN_DELIVERY_ENCRYPTION_KEY_ID=local-v1
APP_BASE_URL=http://127.0.0.1:5173
REGISTRATION_PER_MINUTE=5
VERIFICATION_PER_MINUTE=20
RECOVERY_PER_MINUTE=5
RESET_PER_MINUTE=20
RECOVERY_MIN_RESPONSE_MS=250

# Keep false until a controlled sandbox/provider adapter is explicitly configured.
ACCOUNT_DELIVERY_WORKER_ENABLED=false
ACCOUNT_DELIVERY_BATCH_SIZE=10
ACCOUNT_DELIVERY_POLL_MS=1000
ACCOUNT_DELIVERY_SHUTDOWN_SECONDS=10

# File paths to persistent RSA PKCS#8 private PEM and public-only JWKS; never inline private keys.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEYS=
JWT_KEY_ID=
JWT_ISSUER=
JWT_AUDIENCE=
TOKEN_HASH_PEPPER=
LOGIN_PER_MINUTE=10

# T07 local trial allowances; defaults stay zero until provider/cost review.
TRIAL_AI_DRAFTS=0
TRIAL_SMS_SEGMENTS=0

# T16 server-only private storage. Never copy these into VITE_ variables.
PRIVATE_STORAGE_ENABLED=false
PRIVATE_STORAGE_WORKER_ENABLED=false
S3_ENDPOINT=http://127.0.0.1:8333
S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET_STAGING=collector-staging
S3_BUCKET_PRIVATE=collector-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=13310
IMAGE_WORKER_IMAGE=collector-image-worker:t19
IMAGE_WORKER_DOCKER=docker

# T23: enable on a worker instance after private storage is configured.
EXPORT_WORKER_ENABLED=false
